# Backend port
PORT=4001

# Matchmaking bot-fallback window (ms). Larger lets two humans queue without a
# bot hijacking the match during manual testing. Default 5000.
BOT_MATCH_WAIT_MS=5000

# --- Security ---

# Comma-separated CORS allowlist. The server NEVER uses a wildcard. Set this to
# your web client origin(s) in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:4001,http://10.0.2.2:4001

# Enable auth enforcement (REST + WebSocket). Get it from:
# Supabase Dashboard -> Settings -> API -> JWT Settings -> JWT Secret.
# Leave UNSET only for local testing (server trusts client ids when unset).
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Expose the /ws-test debug socket console. Keep "false" (or unset) in prod.
EXPOSE_WS_TEST=false

# --- Supabase (server-side, NEVER expose to the client) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Disconnect grace period before a match is awarded to the present player (ms).
DISCONNECT_GRACE_MS=10000
